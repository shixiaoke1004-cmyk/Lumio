<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Adhoc-signed builds have no Team ID, so hardened-runtime library
	     validation rejects the embedded MediaRemoteAdapter.framework when
	     launched from a DMG. Safe to remove if signing with a Developer ID. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
